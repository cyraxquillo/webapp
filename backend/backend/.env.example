DATABASE_URL=sqlite:///./django.sqlite3
SECRET_KEY=replace-this-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=false
ALLOWED_HOSTS=yourusername.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
FRONTEND_ORIGINS=
SECURE_COOKIES=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600
SESSION_COOKIE_HTTPONLY=true
X_FRAME_OPTIONS=DENY

# Set these before running seed_demo. Seeded accounts must change passwords after signing in.
DEMO_ADMIN_PASSWORD=
DEMO_CLIENT_PASSWORD=
DEMO_STAFF_PASSWORD=

# Optional SQL database URLs:
# DATABASE_URL=postgresql://user:password@localhost:5432/lexie_performance
# DATABASE_URL=mysql://user:password@localhost:3306/lexie_performance
